# Cordon environment configuration. Copy to .env and fill in; .env is gitignored.
# Generation commands for the secrets below are documented in README.md.

# --- Section: provider keys — Cordon's outbound credentials to each LLM provider ---
# OpenAI key. Required outside mock mode for any openai/* pool model and for the
# default `strong` model (openai/gpt-4o).
OPENAI_API_KEY=

# Mistral key. Recommended: Mistral is the cheapest EU-hosted provider in the
# default pool, so most tenants should have this set for data-residency reasons.
MISTRAL_API_KEY=

# DeepSeek key. Optional. DeepSeek is China-hosted (see SECURITY.md, data
# residency) and is only usable by tenants that explicitly allow the "deepseek"
# provider in allowed_providers.
DEEPSEEK_API_KEY=

# --- Section: telemetry — optional Langfuse tracing, EU region ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU-region Langfuse Cloud host (not the US default), to keep telemetry data in the EU.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Section: Cordon secrets — generated locally, never shared between deployments ---
# Bearer token for /admin. Minimum 32 characters; refused at startup outside mock
# mode if missing, too short, or left at the example value.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CORDON_ADMIN_KEY=

# Base64-encoded 32-byte key used for AES-GCM encryption of cache values at rest.
# Generate: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
CORDON_DATA_KEY=

# Salt (minimum 16 characters) used to key the HMAC-SHA256 hashing of session IDs
# and prompt fingerprints, so they cannot be guessed or collide across tenants.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
CORDON_HASH_SALT=

# --- Section: network — bind address and port ---
# Loopback by default; production runs behind a TLS-terminating reverse proxy.
# In Docker, Cordon always listens on all addresses inside its container;
# docker-compose.yml decides what is published on the host.
CORDON_BIND=127.0.0.1
CORDON_PORT=8787

# --- Section: failsafe (docker-compose only) — the address the apps use ---
# FAILSAFE_BIND=127.0.0.1   # this host's internal address, to reach it from other machines
# FAILSAFE_PORT=8080

# --- Section: mode — offline, deterministic operation without any provider keys ---
# true: LiteLLM mock_response is used everywhere, no network calls, ephemeral
# secrets are generated if the Cordon secrets above are unset. false: real
# provider calls; the secrets above are then mandatory.
MOCK_MODE=true
