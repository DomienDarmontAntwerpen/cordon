# --- Section: Python runtime — never commit the virtual environment or caches ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Section: secrets — .env holds live keys, never committed ---
.env

# --- Section: generated data and reports — regenerated by setup_models/train/benchmark/demo ---
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
reports/*
!reports/model_card.md
!reports/company_day.json

# --- Section: OS / editor noise ---
.DS_Store

# --- Section: external datasets — downloaded for evaluation notebooks, never committed ---
data/external/

# Personal editor settings
.vscode/

# Private working notes (kept locally, not published): the build log and the original specification
CLAUDE.md
docs/CORDON_PROMPT.md
